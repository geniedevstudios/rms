# Same Supabase project as the studio and the invitation site.
# The storefront only reads public.storefront. Schema: rms-admin/supabase/storefront.sql
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# CARTO basemap key for the studio map on Our world. Safe to expose in the browser.
VITE_CARTO_API_KEY=
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
# Studio address used when the shop is deployed. No trailing slash.
# Example: https://admin.rivermindstyle.com
RMS_CONTENT_ORIGIN=
