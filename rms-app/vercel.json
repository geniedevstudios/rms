{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/media/:path*", "destination": "/api/media/:path*" },
    { "source": "/uploads/:path*", "destination": "/api/uploads/:path*" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
