# Secret key from Supabase → Project Settings → API Keys. Server only.
# Writes public.storefront and the private tables in supabase/records.sql.
# Schema: supabase/storefront.sql, supabase/customers.sql, supabase/newsletter.sql, and supabase/records.sql
# The project URL can be omitted here; development falls back to rms-app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RMS_ADMIN_EMAIL=
RMS_ADMIN_PASSWORD=
RESEND_API_KEY=
RESEND_FROM=

# Customer/admin notification links and delivery switch.
RMS_STOREFRONT_URL=https://rivermindstyle.com
RMS_ADMIN_URL=https://admin.rivermindstyle.com
RMS_EMAIL_AUTOMATION_ENABLED=true
# Optional; defaults to RMS_ADMIN_EMAIL.
RMS_NOTIFICATION_EMAIL=
# Required on the production admin server; development can reuse rms-app's key.
PAYSTACK_SECRET_KEY=
# Vercel sends this to the daily mail schedule. Use the same value in the studio project settings.
CRON_SECRET=

RESEND_ORDERS_FROM="RIVERMINDSTYLE <orders@rivermindstyle.com>"
RESEND_CONSULTATION_FROM="RIVERMINDSTYLE <consultation@rivermindstyle.com>"
RESEND_PAYMENTS_FROM="RIVERMINDSTYLE <payments@rivermindstyle.com>"
RESEND_CARE_FROM="RIVERMINDSTYLE <care@rivermindstyle.com>"
RESEND_VERIFICATION_FROM="RIVERMINDSTYLE <verification@rivermindstyle.com>"

# Online meetings are created on this calendar after one Google sign-in.
# Use an OAuth Web client. Redirect URIs:
# http://127.0.0.1:5175/api/cms/calendar/callback
# https://admin.rivermindstyle.com/api/cms/calendar/callback
# Shippo test tokens start with shippo_test_. A live token buys real labels.
SHIPPO_API_TOKEN=
SHIPPO_FROM_STREET=Vanilla Street
SHIPPO_FROM_CITY=Adenta
SHIPPO_FROM_STATE=Greater Accra
SHIPPO_FROM_ZIP=
SHIPPO_FROM_PHONE=
SHIPPO_FROM_EMAIL=rivermindstyle.operations@gmail.com

GOOGLE_CALENDAR_ID=rivermindstyle.operations@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Cloudflare R2 for studio uploads. Set all five together on the admin server.
R2_S3_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
